# Set this to a managed PostgreSQL connection string (for example Render PostgreSQL).
DATABASE_URL=postgresql://user:password@host:5432/database
# Set to true only when your PostgreSQL provider requires TLS.
DATABASE_SSL=false
# A long, random secret used to sign login cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret
# Resend API key and a verified sender address.
RESEND_API_KEY=
EMAIL_FROM=AlphaVerse Construction <noreply@example.com>
INQUIRY_NOTIFICATION_EMAIL=
# Required once to create the first administrator. Store as deployment secrets.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional exact public origin to validate form submissions against.
ALLOWED_ORIGIN=
PORT=3000
